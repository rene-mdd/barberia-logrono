# Copy to .env and replace the values. .env is ignored by git.
# Generate strong passwords with:  openssl rand -base64 24
#
# Note: MariaDB only applies these when its data volume is first created.
# To change the password of an existing database, run ALTER USER in MariaDB
# first, then update this file.

DB_NAME=wordpress
DB_USER=wpuser
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Host port for the website (production behind a proxy often uses 8080 or 80).
WP_PORT=8081
